<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">
    <persistence-unit name="sgdaPU" transaction-type="JTA">
        <jta-data-source>jdbc/SGDADS</jta-data-source>

        <class>com.sgda.domain.Role</class>
        <class>com.sgda.domain.EtatDemande</class>
        <class>com.sgda.domain.TypeDemande</class>
        <class>com.sgda.domain.Utilisateur</class>
        <class>com.sgda.domain.Demande</class>
        <class>com.sgda.domain.Commentaire</class>
        <class>com.sgda.domain.PieceJointe</class>
        <class>com.sgda.domain.HistoriqueTransition</class>

        <properties>
            <property name="jakarta.persistence.schema-generation.database.action" value="none"/>
            <property name="jakarta.persistence.validation.mode" value="NONE"/>
        </properties>
    </persistence-unit>
</persistence>